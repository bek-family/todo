todo-title = Задачи
todo-new = Новая задача
todo-all = Все
todo-active = Активные
todo-done = Выполненные
todo-left = { $count ->
    [0] Все задачи выполнены
    [one] Осталась { $count } задача
    [few] Осталось { $count } задачи
   *[many] Осталось { $count } задач
}
todo-empty = Задач пока нет
todo-empty-hint = Введите задачу выше и нажмите Enter.
todo-nothing-active = Активных задач нет
todo-nothing-active-hint = Все задачи выполнены.
todo-nothing-done = Выполненных задач нет
todo-nothing-done-hint = Нажмите на задачу, когда она выполнена.
todo-clear = Удалить выполненные
todo-deleted = Задача удалена
todo-cleared = { $count ->
    [one] Удалена { $count } задача
    [few] Удалено { $count } задачи
   *[many] Удалено { $count } задач
}
todo-undo = Отменить
todo-not-kept = Хранилище заполнено: задачи не сохранены.
todo-mark-done = Отметить выполненной
todo-mark-undone = Снять отметку
todo-delete = Удалить
